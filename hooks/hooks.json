{
  "description": "ck-tools hooks: the formatter after edits, and the mod (hooks module) for the plan-limit band, its toasts, the update check and the zero-model /usage-pace and /usage-band, and the bug reporter that spots a crash in this plugin's own scripts",
  "modules": [
    "./mod/register.tsx"
  ],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/format.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/bin/ck-tools-report hook",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/bin/ck-tools-report hook",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
